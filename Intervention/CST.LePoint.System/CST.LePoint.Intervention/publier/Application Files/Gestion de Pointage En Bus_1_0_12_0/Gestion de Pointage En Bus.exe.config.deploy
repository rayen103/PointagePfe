<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
  </configSections>
  <appSettings>
    <add key="Langue" value="fr-FR" />
    <add key="Separateur" value="\t" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="MAJ_PRIX_REVIENT" value="false" />
    <add key="ENTREPOT_PRODUCTION" value="03" />
    <add key="STATUT_INITIALE_LOT" value="Q" />
    <add key="POURCENTAGE_TAUX_FORFAITAIRE" value="1" />
    <add key="MONTANT_TIMBRE_FISCAL" value="0.600" />
    <add key="DELAIE_ECHEANCE" value="1" />
    <add key="CODE_ARTICLE_DIVERS" value="9999" />
    <add key="ENTREPOT_LIVRAISON" value="01" />
    <add key="NomApplication" value="CST.LePoint.GestionPointageBus" />
    <add key="MODE_APPLICATION" value="ADMINISTRATION1" />
    <add key="SECURITE_ACTIVEE" value="true" />
    <add key="UTILISER_GAUTO_OV" value="true" />

  </appSettings>
  <connectionStrings>
    <add name="CST_ConnectionString" connectionString="Data Source=192.168.1.100;User ID=sa;Password=@dmin123;Initial Catalog=CstDataSAGEM"
      providerName="System.Data.SqlClient" />
    <add name="CST.LePoint.Intervention.Properties.Settings.CstDataConnectionString"
      connectionString="Data Source=192.168.1.100;Initial Catalog=CstDataSAGEM;User ID=sa;Password=@dmin123"
      providerName="System.Data.SqlClient" />
    <add name="CST.LePoint.Intervention.Properties.Settings.CstDataSincerCConnectionString"
      connectionString="Data Source=192.168.1.100;Initial Catalog=CstDataSAGEM;User ID=sa;Password=@dmin123"
      providerName="System.Data.SqlClient" />
    <add name="CST.LePoint.Intervention.Properties.Settings.CstDataSAGEM"
      connectionString="Data Source=192.168.1.100;Initial Catalog=CstDataSincerC;User ID=sa;Password=@dmin123"
      providerName="System.Data.SqlClient" />
    <add name="CST.LePoint.Intervention.Properties.Settings.CstDataSMHITConnectionString"
      connectionString="Data Source=192.168.1.100;Initial Catalog=CstDataSincerC;User ID=sa;Password=@dmin123"
      providerName="System.Data.SqlClient" />
  </connectionStrings>
  <runtime>
    <generatepublisherevidence enabled="false" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="GMap.NET.Core" publicKeyToken="b85b9027b614afef" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.7.0.0" newVersion="1.7.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Data.SQLite" publicKeyToken="db937bc2d44ff139" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.0.105.0" newVersion="1.0.105.0" />
        <enforceFIPSPolicy enabled="false" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <system.diagnostics>
    <switches>
      <add name="TraceBooleanSwitch" value="1" />
      <!--      This switch controls general messages. In order to
                        receive general trace messages change the value to the
                        appropriate level.
                        "1" gives error messages                             use : traceLevelSwitch.TraceError,
                        "2" gives errors and warnings                  use : traceLevelSwitch.TraceWarning,
                        "3" gives more detailed error information,     use : traceLevelSwitch.TraceInfo
                        "4" gives verbose trace information            use : traceLevelSwitch.TraceVerbose-->
      <add name="TraceLevelSwitch" value="4" />
    </switches>
    <trace autoflush="true" indentsize="0">
      <listeners>
        <!-- Rotating Log FILE -->
        <add name="LogToFile" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter" logFileCreationSchedule="Daily" traceOutputOptions="DateTime" BaseFileName="AJ" location="Custom" CustomLocation="Rotating Log" Delimiter="|" AutoFlush="True" Append="True" />
        <add name="configConsoleListener" type="System.Diagnostics.ConsoleTraceListener" />
      </listeners>
    </trace>
  </system.diagnostics>
  <!--<system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri=""/>
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400"/>
      </providers>
    </roleManager>
  </system.web>-->
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="v11.0" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
      <provider invariantName="System.Data.SQLite.EF6" type="System.Data.SQLite.EF6.SQLiteProviderServices, System.Data.SQLite.EF6" />
    </providers>
  </entityFramework>
  <system.data>
    <DbProviderFactories>
      <remove invariant="System.Data.SQLite.EF6" />
      <add name="SQLite Data Provider (Entity Framework 6)" invariant="System.Data.SQLite.EF6" description=".NET Framework Data Provider for SQLite (Entity Framework 6)" type="System.Data.SQLite.EF6.SQLiteProviderFactory, System.Data.SQLite.EF6" />
    </DbProviderFactories>
  </system.data>
</configuration>